<?xml version="1.0"?>
<opnsense>
  <version>25.7.10</version>
  <theme>opnsense</theme>
  <system>
    <optimization>normal</optimization>
    <hostname>OPNsense</hostname>
    <domain>internal</domain>
    <dnsallowoverride>0</dnsallowoverride>
    <dnsserver>10.10.1.2</dnsserver>
    <dnsserver>8.8.8.8</dnsserver>
    <timezone>UTC</timezone>
    <webgui>
      <protocol>https</protocol>
      <port>443</port>
      <interfaces>lan</interfaces>
    </webgui>
    <ssh>
      <enabled>enabled</enabled>
      <port>22</port>
      <interfaces>lan</interfaces>
    </ssh>
  </system>
  <interfaces>
    <wan>
      <enable>1</enable>
      <if>em0</if>
      <ipaddr>10.10.1.254</ipaddr>
      <subnet>24</subnet>
      <gateway>WAN_GW</gateway>
      <descr>WAN</descr>
    </wan>
    <lan>
      <enable>1</enable>
      <if>em2</if>
      <ipaddr>192.168.100.254</ipaddr>
      <subnet>24</subnet>
      <descr>LAN</descr>
    </lan>
    <opt1>
      <enable>1</enable>
      <if>em1</if>
      <ipaddr>172.16.100.254</ipaddr>
      <subnet>24</subnet>
      <descr>DMZ_PUB</descr>
    </opt1>
    <opt2>
      <enable>1</enable>
      <if>em3</if>
      <ipaddr>172.16.200.254</ipaddr>
      <subnet>24</subnet>
      <descr>DMZ_PROD</descr>
    </opt2>
  </interfaces>
  <gateways>
    <gateway_item>
      <interface>wan</interface>
      <gateway>10.10.1.2</gateway>
      <name>WAN_GW</name>
      <weight>1</weight>
      <descr>VMware Host Gateway</descr>
      <defaultgw>1</defaultgw>
    </gateway_item>
  </gateways>
  <filter>
    <aliases>
      <alias>
        <name>ADMIN_IP</name>
        <type>host</type>
        <address>192.168.100.20</address>
        <descr>Poste d'administration privilégie</descr>
      </alias>
      <alias>
        <name>CLIENT_PC</name>
        <type>host</type>
        <address>192.168.100.21</address>
        <descr>Poste client LAN standard</descr>
      </alias>
      <alias>
        <name>Web_DMZPUB</name>
        <type>host</type>
        <address>172.16.100.80</address>
        <descr>Serveur Web Apache en DMZ Publique</descr>
      </alias>
      <alias>
        <name>Tomcat_DMZPROD</name>
        <type>host</type>
        <address>172.16.200.80</address>
        <descr>Serveur d'application Tomcat en DMZ Production</descr>
      </alias>
      <alias>
        <name>DNS_VMware</name>
        <type>host</type>
        <address>10.10.1.2</address>
        <descr>Serveur DNS VMware autorisé</descr>
      </alias>
      <alias>
        <name>Web_Ports</name>
        <type>port</type>
        <address>80 443</address>
        <descr>Ports Web HTTP et HTTPS</descr>
      </alias>
      <alias>
        <name>FW_MGMT_PORTS</name>
        <type>port</type>
        <address>22 443</address>
        <descr>Ports de gestion pare-feu SSH et WebGUI</descr>
      </alias>
      <alias>
        <name>TOMCAT8080</name>
        <type>port</type>
        <address>8080</address>
        <descr>Port par défaut Apache Tomcat</descr>
      </alias>
      <alias>
        <name>PROXY_PORT</name>
        <type>port</type>
        <address>3128</address>
        <descr>Port d'écoute du mandataire Squid</descr>
      </alias>
    </aliases>
    <rules>
      <!-- Règle F1 / R9 : Administration complète pour ADMIN_IP -->
      <rule>
        <type>pass</type>
        <interface>lan</interface>
        <ipprotocol>inet</ipprotocol>
        <statetype>keep state</statetype>
        <direction>in</direction>
        <quick>1</quick>
        <source>
          <address>ADMIN_IP</address>
        </source>
        <destination>
          <any>1</any>
        </destination>
        <descr>R9: ADMIN -> All permissions</descr>
      </rule>
      <!-- Règle F2 / R5 : DNS autorisé vers 10.10.1.2 -->
      <rule>
        <type>pass</type>
        <interface>lan</interface>
        <ipprotocol>inet</ipprotocol>
        <protocol>udp</protocol>
        <statetype>keep state</statetype>
        <direction>in</direction>
        <quick>1</quick>
        <source>
          <network>lan</network>
        </source>
        <destination>
          <address>DNS_VMware</address>
          <port>53</port>
        </destination>
        <descr>R5: DNS TCP/UDP vers DNS_VMware</descr>
      </rule>
      <!-- Règle F4 / R10 : Client vers Proxy Squid -->
      <rule>
        <type>pass</type>
        <interface>lan</interface>
        <ipprotocol>inet</ipprotocol>
        <protocol>tcp</protocol>
        <statetype>keep state</statetype>
        <direction>in</direction>
        <quick>1</quick>
        <source>
          <network>lan</network>
        </source>
        <destination>
          <network>(self)</network>
          <port>PROXY_PORT</port>
        </destination>
        <descr>R10: LAN -> Proxy Squid (3128)</descr>
      </rule>
      <!-- Règle F5 / R10 : Blocage accès direct Web pour les clients LAN -->
      <rule>
        <type>block</type>
        <interface>lan</interface>
        <ipprotocol>inet</ipprotocol>
        <protocol>tcp</protocol>
        <direction>in</direction>
        <quick>1</quick>
        <source>
          <network>lan</network>
        </source>
        <destination>
          <any>1</any>
          <port>Web_Ports</port>
        </destination>
        <descr>R10: Block direct HTTP/HTTPS navigation</descr>
      </rule>
      <!-- Règle F6 / R2 : LAN vers Serveur Web DMZ -->
      <rule>
        <type>pass</type>
        <interface>lan</interface>
        <ipprotocol>inet</ipprotocol>
        <protocol>tcp</protocol>
        <statetype>keep state</statetype>
        <direction>in</direction>
        <quick>1</quick>
        <source>
          <network>lan</network>
        </source>
        <destination>
          <address>Web_DMZPUB</address>
          <port>Web_Ports</port>
        </destination>
        <descr>R1/R2: LAN -> Web_DMZPUB (80/443)</descr>
      </rule>
      <!-- Règle F7 / R8 : LAN vers Serveur Tomcat DMZ -->
      <rule>
        <type>pass</type>
        <interface>lan</interface>
        <ipprotocol>inet</ipprotocol>
        <protocol>tcp</protocol>
        <statetype>keep state</statetype>
        <direction>in</direction>
        <quick>1</quick>
        <source>
          <network>lan</network>
        </source>
        <destination>
          <address>Tomcat_DMZPROD</address>
          <port>TOMCAT8080</port>
        </destination>
        <descr>R8: LAN -> Tomcat_DMZPROD (8080)</descr>
      </rule>
      <!-- Règle F8 / R6 : Ping ICMP vers DMZs -->
      <rule>
        <type>pass</type>
        <interface>lan</interface>
        <ipprotocol>inet</ipprotocol>
        <protocol>icmp</protocol>
        <icmptype>echoreq</icmptype>
        <statetype>keep state</statetype>
        <direction>in</direction>
        <quick>1</quick>
        <source>
          <network>lan</network>
        </source>
        <destination>
          <any>1</any>
        </destination>
        <descr>R6: ICMP Echo LAN -> DMZs</descr>
      </rule>
      <!-- Règle F10 / R3 : Protection critique Anti-Rebond DMZ -> LAN -->
      <rule>
        <type>block</type>
        <interface>opt1</interface>
        <ipprotocol>inet</ipprotocol>
        <direction>in</direction>
        <quick>1</quick>
        <source>
          <network>opt1</network>
        </source>
        <destination>
          <network>lan</network>
        </destination>
        <descr>R3: Protection critique - Bloquer DMZ_PUB vers LAN net</descr>
      </rule>
      <rule>
        <type>block</type>
        <interface>opt2</interface>
        <ipprotocol>inet</ipprotocol>
        <direction>in</direction>
        <quick>1</quick>
        <source>
          <network>opt2</network>
        </source>
        <destination>
          <network>lan</network>
        </destination>
        <descr>R3: Protection critique - Bloquer DMZ_PROD vers LAN net</descr>
      </rule>
    </rules>
  </filter>
  <nat>
    <rule>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <destination>
        <network>wanip</network>
        <port>80</port>
      </destination>
      <target>172.16.100.80</target>
      <local-port>443</local-port>
      <descr>R7: Port Forward WAN:80 -> Web_DMZPUB:443</descr>
    </rule>
  </nat>
</opnsense>

